PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# Database Configuration
# In production or if local PostgreSQL is running:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/storegrid?schema=public

# Development Fallback:
# If PostgreSQL is not installed or unreachable, StoreGrid automatically activates
# a local SQLite fallback database at data/storegrid_dev.sqlite.
# Force fallback explicitly by setting:
# USE_DB_FALLBACK=true

# Upload limits
MAX_FILE_SIZE_MB=5
MAX_CSV_RECORDS=5000

# Analytics & Spike Detection Baseline Thresholds
SPIKE_THRESHOLD_FACTOR=2.0
SPIKE_MIN_COUNT=3

# Varshith's FastAPI NLP Classification Microservice
NLP_SERVICE_URL=http://127.0.0.1:8000
NLP_TIMEOUT_MS=3000
